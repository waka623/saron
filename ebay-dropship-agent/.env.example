# --- 販路選択(S0で導入。DECISIONS.md参照) ---
# どのSalesChannel実装を使うか。既定はebay(誤爆防止)。shopifyを使う場合のみ明示的に変更する。
CHANNEL=ebay

# --- Shopify Admin API(S1、channels/shopify.py。CHANNEL=shopify のときのみ使用) ---
# カスタムアプリのAdmin APIアクセストークンで認証する。値はいずれも空でよい(CHANNEL=ebayの間は未使用)。
SHOPIFY_STORE_DOMAIN=
SHOPIFY_ACCESS_TOKEN=
# 仮定の既定値は置いていない。https://shopify.dev/docs/api/usage/versioning で
# 現在のstableバージョン(例: "2024-10"のような形式)を確認して設定すること。
SHOPIFY_API_VERSION=

# --- Printify(POD、S2、pod/・adapters/printify/) ---
PRINTIFY_API_TOKEN=
PRINTIFY_SHOP_ID=
# レベルB(承認必須)のdeny-by-defaultガード。原価がこれを超える発注提案はhold(自動発注しない)。
# 仮の初期値。実際の商品原価帯に合わせて要調整。
MAX_SUPPLIER_ORDER_COST=50.00

# --- eBay Sell API (必ず Sandbox から) ---
EBAY_ENV=sandbox
EBAY_CLIENT_ID=
EBAY_CLIENT_SECRET=
EBAY_REDIRECT_URI=
EBAY_REFRESH_TOKEN=
# execute-publish --live に必要(未設定だとpublishOfferが失敗する)。
# `ebay-dropship sandbox setup-selling` が自動取得/作成して書き込む。手で埋める必要はない。
EBAY_PAYMENT_POLICY_ID=
EBAY_RETURN_POLICY_ID=
EBAY_FULFILLMENT_POLICY_ID=
EBAY_MERCHANT_LOCATION_KEY=default
# Inventory/Offer系の書き込み(Content-Language)とBrowse API(X-EBAY-C-MARKETPLACE-ID)に必須の
# ヘッダー値。marketplaceを変更する場合は両方をあわせて変更すること。
EBAY_MARKETPLACE_ID=EBAY_US
EBAY_CONTENT_LANGUAGE=en-US
# eBay Marketplace Account Deletion/Closure 通知(api/account_deletion.py)。
# 本番投入準備が整うまで空でよい。値はeBay開発者ポータルで登録するverificationTokenと同じもの
# (32〜80文字、英数字と_-のみ)、およびそのポータルに登録するこのエンドポイントの完全なURL。
EBAY_DELETION_VERIFICATION_TOKEN=
EBAY_DELETION_ENDPOINT_URL=

# --- サプライヤー連携(未定のため両対応。MVPはCSVから開始) ---
SUPPLIER_INTEGRATION_MODE=csv
SUPPLIER_CSV_PATH=./data/supplier_feed.csv
SUPPLIER_API_BASE_URL=
SUPPLIER_API_KEY=
# サプライヤーデータの鮮度閾値(分)。これより古いin/在庫・原価データは発注に使わずholdにする。
SUPPLIER_DATA_MAX_AGE_MINUTES=1440

# --- 実発注(自動)の有効化フラグ。実サプライヤー統合+明示的go-liveまでOFF固定。安易に変更しないこと ---
ENABLE_AUTOMATED_SUPPLIER_PURCHASE=false

# --- S3: スケジュール自走(オプトイン、レベルB。DECISIONS.md参照) ---
# 既定はすべて安全側(自走オフ)。何も設定しなければ人間の承認なしに何も自動実行されない。
# publish(出品公開)等の"お金が動かない"副作用のみが自動承認の対象になりうる
# (supplier_purchase等の金銭・破壊系は設定に関わらずコードレベルで対象外。guardrails/autonomy.py参照)。
AUTONOMY_ENABLED=false
AUTO_APPROVE_PUBLISH=false
MAX_AUTO_ACTIONS_PER_RUN=3
# 緊急停止スイッチ。trueにすると AUTONOMY_ENABLED の値に関わらず即座に自動承認を止められる。
AUTONOMY_KILL_SWITCH=false

# --- 利益ガード(2026-09-06 経営判断により20%→15%へ引き下げ。DECISIONS.md参照) ---
# 目標純利益率 15% / 最低純利益 1注文あたり $5(下限は不変)
TARGET_MARGIN_PCT=15
MIN_NET_PROFIT=5.0

# 除外カテゴリ(コード, カンマ区切り)。意味は以下の通り。値はここを編集するだけで変更可能(コード直書きしない)。
#   luxury_brand_goods       = ブランド・高級品
#   authentication_required  = 時計・スニーカー等の要鑑定品
#   hazmat                   = 危険物
#   food_supplements_pharma  = 食品・サプリ・医薬品
#   adult                    = アダルト
#   gift_cards               = ギフトカード
EXCLUDED_CATEGORIES=luxury_brand_goods,authentication_required,hazmat,food_supplements_pharma,adult,gift_cards

# --- 承認 UI(CLIから開始、Webへ拡張) ---
APPROVAL_UI_MODE=both
APPROVAL_HIGH_RISK_DISCOUNT_PCT=15

# --- PDCA サイクル ---
PDCA_CYCLE=daily

# --- pricing(Act)のフィードバック安定化ガード ---
PRICING_COOLDOWN_DAYS=7
PRICING_MIN_SAMPLE_VIEWS=30
PRICING_DISCOUNT_STEP_PCT=10

# --- 承認Web UI(api/) ---
# "username:password" のカンマ区切り(複数運用者可)。空のままだと誰も認証できない(fail-closed)。
# 実運用ではランダムな強いパスワードに変更すること。ここに実際の認証情報を書いてコミットしない。
APPROVAL_API_USERS=
APPROVAL_API_HOST=127.0.0.1
APPROVAL_API_PORT=8000

# --- DB ---
DATABASE_URL=sqlite:///./ebay_dropship.db
