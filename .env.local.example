# Supabase (https://app.supabase.com/project/_/settings/api で取得)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# LINE Developers Console (Messaging API チャネル) から取得
# チャネルごとの値は salons テーブルにサロン単位で保存するため、
# ここでは Webhook 検証やローカル開発用の共通値のみを置く想定
CRON_SECRET=change-me-to-a-random-string
